# ==============================================================================
# ApexCRM Environment Configuration Example
# Copy this file to .env.local and update with your real production/staging keys.
# ==============================================================================

# Google Gemini API Key (Required for AI Smart Notes, Next-Best-Action, Copilot, Email Drafting)
GEMINI_API_KEY="your-gemini-api-key-here"

# Supabase / PostgreSQL Database Connection Strings
# DATABASE_URL: Connection pooler port (e.g., 6543 with pgbouncer=true) for runtime queries
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct database connection (port 5432) for migrations & schema push
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres"

# Authentication & Session Security Secrets
AUTH_SECRET="generate-a-secure-random-32-byte-hex-or-base64-secret"
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-hex-or-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional Seed Configuration
SEED_DEFAULT_PASSWORD="password123"
